# ==============================================================================
# TRIMEDI HEALTHCARE BACKEND ENVIRONMENT CONFIGURATION (SAMPLE / TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit the real .env file with production credentials or API keys.

# Environment Mode: development | staging | pilot | production
NODE_ENV=development
APP_ENV=development

# Controlled Pilot Configuration
# When APP_ENV=pilot, database fallback mocks are disabled by default unless explicitly allowed:
ALLOW_PILOT_MOCKS=false

# Server Port
PORT=5001

# MongoDB Connection URI
# Local: mongodb://localhost:27017/trimedi
# Cluster: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/trimedi?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/trimedi

# Authentication & JWT
# Generate a cryptographically secure random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# CORS Configuration
# Comma-separated or single URL of the allowed frontend client
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API for Clinical NLP Assistive Intelligence
# If omitted or offline, TriMedi seamlessly uses resilient local clinical heuristics
GEMINI_API_KEY=

# PayPal Payment Gateway (Sandbox / Live)
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Optional: Redis Distributed Security & Pub/Sub Store
REDIS_URL=

# Optional: Initial Administrator Bootstrap (Created on db:seed / db:init)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
