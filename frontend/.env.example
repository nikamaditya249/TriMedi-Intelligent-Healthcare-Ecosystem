# ==============================================================================
# TRIMEDI HEALTHCARE FRONTEND ENVIRONMENT CONFIGURATION (SAMPLE / TEMPLATE)
# ==============================================================================
# Copy this file to .env or .env.local to configure for development, staging, or production.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER include private backend secrets (e.g., JWT secrets, database passwords) here!

# Backend REST API endpoint (includes /api suffix)
# Development: http://localhost:5001/api
# Staging/Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5001/api

# Real-time WebSocket / Socket.IO server URL
# Development: http://localhost:5001
# Staging/Production: https://api.yourdomain.com
VITE_SOCKET_URL=http://localhost:5001
